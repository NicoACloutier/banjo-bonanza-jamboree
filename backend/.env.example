# Banjo Tabs -- environment variables
#
# Copy this file to `.env` (for the backend) and fill in real values for
# your environment (local dev, CI, or AWS free-tier deployment). Never
# commit the real `.env` file -- only this template.
#
# The frontend (Vite) reads its own `VITE_*` variables from
# `frontend/.env` (see `frontend/.env.example`), since Vite only exposes
# variables prefixed with VITE_ to client-side code.

# --- Core ---
ENVIRONMENT=
DEBUG=

# --- Database (PostgreSQL) ---
# Example shape: postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
# On AWS free tier, this would point at an RDS PostgreSQL db.t3.micro instance.
DATABASE_URL=

# --- JWT auth ---
# Generate a long, random secret (e.g. `openssl rand -hex 32`). Never reuse
# across environments.
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# --- Google OAuth2 (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=

# --- App info ---
APP_NAME=
