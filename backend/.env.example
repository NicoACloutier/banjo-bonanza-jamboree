# Banjo Tabs -- environment variables
#
# Copy this file to `.env` for local development: it works as-is (blank
# values fall back to their defaults), but set JWT_SECRET_KEY. For
# production settings see DEPLOYMENT.md. Never commit the real `.env` file
# -- only this template.
#
# The frontend (Vite) reads its own `VITE_*` variables from
# `frontend/.env` (see `frontend/.env.example`), since Vite only exposes
# variables prefixed with VITE_ to client-side code.

# --- Core ---
# "development" creates missing tables automatically; anything else (e.g.
# "production") requires JWT_SECRET_KEY and uses Alembic migrations.
ENVIRONMENT=development
DEBUG=false

# --- Database (PostgreSQL) ---
# Example shape: postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
# Plain postgres:// or postgresql://...?sslmode=require URLs (as Neon and most
# hosts give them out) also work; they're converted for asyncpg on startup.
# Leave empty for a local SQLite file (banjo_tabs.db).
DATABASE_URL=

# --- JWT auth ---
# Generate a long, random secret, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse it across environments.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google OAuth2 (https://console.cloud.google.com/apis/credentials) ---
# Optional: leave the client id/secret blank to use username/password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
# Optional regex for more origins, e.g. Cloudflare Pages preview deploys:
# ^https://([a-z0-9-]+\.)?your-project\.pages\.dev$
CORS_ORIGIN_REGEX=

# --- Email (password reset links) ---
# The site's address, used in links in emails. Leave empty to use the first
# CORS_ORIGINS entry.
FRONTEND_URL=
# SMTP server to send email through. Leave SMTP_HOST empty to not send email:
# in development the message is printed in the server output instead.
SMTP_HOST=
SMTP_PORT=587
# "starttls" (usually port 587), "ssl" (usually port 465) or "none".
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender, e.g. "Banjo Bonanza Jamboree <noreply@example.com>". Defaults to
# SMTP_USERNAME.
EMAIL_FROM=

# --- App info ---
APP_NAME="Banjo Bonanza Jamboree"
