# Banjo Tabs frontend -- environment variables
#
# Copy this file to `.env` (or `.env.local` for machine-specific overrides)
# inside `frontend/`. Only variables prefixed with VITE_ are exposed to the
# browser bundle, per Vite's convention.

# Base URL of the backend API (no trailing slash).
VITE_API_BASE_URL=

# Google OAuth2 client id (same project as the backend's GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=

# Must exactly match an authorized redirect URI configured in the Google
# Cloud Console, and must match the backend's GOOGLE_REDIRECT_URI. Typically
# "<frontend-origin>/auth/google/callback".
VITE_GOOGLE_REDIRECT_URI=
