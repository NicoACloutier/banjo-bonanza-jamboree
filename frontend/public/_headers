# Cloudflare Pages response headers (see DEPLOYMENT.md).

# The service worker must always be re-checked, or a new version of the app
# could be stuck behind an old cached one.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# Vite's bundles have content hashes in their names, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
